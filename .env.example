# Copy to .env.local and fill in. Never commit .env.local.

# --- Prava (payments) ------------------------------------------------------
# Sandbox is a different HOST, not a path prefix on production.
PRAVA_BASE_URL=https://sandbox.api.prava.space
# Server-side only. Must never reach the browser.
MERCHANT_SECRET_KEY=sk_test_...
# Safe for the frontend.
NEXT_PUBLIC_PUBLISHABLE_KEY=pk_test_...
# Enrolled card to pre-select at checkout. Without it the checkout offers the
# customer's default card, which is not necessarily the one you want on camera.
PRAVA_CARD_ID=card_...

# --- Duffel (flight inventory, hold orders, e-ticket settlement) -----------
DUFFEL_BASE_URL=https://api.duffel.com
DUFFEL_API_KEY=duffel_test_...

# --- Linq (inbound/outbound iMessage) --------------------------------------
# Optional. Without it the built-in demo channel is used.
LINQ_API_KEY=

# --- Senso (policy source of record) ---------------------------------------
# Optional. Without it the policy falls back to the committed policy.json.
SENSO_API_KEY=

# --- Runtime ---------------------------------------------------------------
# `imessage` to receive real messages via Linq; anything else uses the demo
# channel. The demo channel is watched either way.
CHANNEL=demo
PORT=3000
